# Server-side only. Copy values privately to Vercel; never prefix with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
VAPID_PUBLIC_KEY=PUBLIC_KEY_FROM_LOCAL_GENERATOR
VAPID_PRIVATE_KEY=PRIVATE_KEY_FROM_LOCAL_GENERATOR
VAPID_SUBJECT=https://github.com/Giaveno/tp-sf-vecino
APP_ORIGIN=https://YOUR_PROJECT.vercel.app
# Optional namespace isolates one application's records in the dedicated schema.
PUSH_NAMESPACE=sf-vecino:v1
# Vercel selects the pinned package manager from package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
